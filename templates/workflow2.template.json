{
  "name": "2. Salon Lead Follow-up Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "e1f10001-1111-4000-8000-000000000001",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "{{GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      },
      "id": "e1f10002-2222-4000-8000-000000000002",
      "name": "Get Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "regex",
                "singleValue": true
              },
              "rightValue": "hot|warm"
            },
            {
              "id": "c2",
              "leftValue": "={{ Number($json.followups_sent || 0) }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "rightValue": 3
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1f10003-3333-4000-8000-000000000003",
      "name": "Filter Eligible Leads",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the front desk receptionist at a premier salon. Write a WhatsApp follow-up message to a lead.\nLead Name: {{ $json.name }}\nService Interest: {{ $json.interest }}\n\nIMPORTANT: Output ONLY the exact message text to send to the customer on WhatsApp. Keep it warm, polite, and maximum 2 sentences offering to reserve a time slot. Do not include markdown headers, options, quotes, or introductory text.",
        "options": {
          "systemMessage": "Write a short, friendly, and non-pushy WhatsApp follow-up message (1-2 sentences) from a salon front desk. Acknowledge their interest in the service, offer to book a convenient time slot, and keep it warm. Do not add quotes."
        }
      },
      "id": "e1f10004-4444-4000-8000-000000000004",
      "name": "Gemini Draft Follow-up",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "modelName": "{{GEMINI_MODEL}}",
        "options": {
          "temperature": 0.5
        }
      },
      "id": "e1f10005-5555-4000-8000-000000000005",
      "name": "Google Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        660,
        400
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "pc3IysFEYjHZVQaj",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "{{WHATSAPP_PHONE_NUMBER_ID}}",
        "recipientPhoneNumber": "={{ String($('Filter Eligible Leads').item.json.phone).replace(/\\D/g, '') }}",
        "textBody": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "e1f10006-6666-4000-8000-000000000006",
      "name": "Send WhatsApp Follow-up",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        900,
        200
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "FLNobig6mXUL6LB5",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "{{GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ String($('Filter Eligible Leads').item.json.phone).replace(/\\D/g, '') }}",
            "followups_sent": "={{ Number($('Filter Eligible Leads').item.json.followups_sent || 0) + 1 }}",
            "last_followup_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [
            "phone"
          ]
        },
        "options": {}
      },
      "id": "e1f10007-7777-4000-8000-000000000007",
      "name": "Update Lead Stats",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "manual-trigger-z5cp2bh2oiszqccd",
      "name": "Manual Test Trigger",
      "webhookId": "{{CLIENT_ID}}-wf2-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        200
      ],
      "parameters": {
        "path": "{{CLIENT_ID}}-wf2-trigger",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      }
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Get Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Leads": {
      "main": [
        [
          {
            "node": "Filter Eligible Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Eligible Leads": {
      "main": [
        [
          {
            "node": "Gemini Draft Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Draft Follow-up": {
      "main": [
        [
          {
            "node": "Send WhatsApp Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "Gemini Draft Follow-up",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Follow-up": {
      "main": [
        [
          {
            "node": "Update Lead Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test Trigger": {
      "main": [
        [
          {
            "node": "Get Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  }
}