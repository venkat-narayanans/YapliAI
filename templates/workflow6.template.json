{
  "name": "6. Bonus – Daily Owner Report on WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 22
            }
          ]
        }
      },
      "id": "4d00c029-5c54-480d-a483-3dc6fcbfe765",
      "name": "Every Night 10PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "path": "{{CLIENT_ID}}-wf6-trigger",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "id": "manual-trigger-wf6",
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "{{GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      },
      "id": "bd95f87c-ff62-40d2-a3e8-4103746da0c9",
      "name": "Today's Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        -160
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "{{CALENDAR_ID}}",
          "mode": "id"
        },
        "returnAll": true,
        "timeMin": "={{ $now.plus({ days: 1 }).startOf('day').toISO() }}",
        "timeMax": "={{ $now.plus({ days: 1 }).endOf('day').toISO() }}",
        "options": {
          "singleEvents": true
        }
      },
      "id": "2d9b639e-d1b2-4314-bedf-bc40781bcf1e",
      "name": "Tomorrow's Bookings",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        240,
        160
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rmqcjqmuX5ayNRTk",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {},
      "id": "b5bfff94-bae7-4326-9f0c-ff89ef6171ad",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const today = $now.toISODate();\nconst leads = $('Today\\'s Leads').all().map(i => i.json).filter(l => String(l.last_message_at || '').startsWith(today));\nconst hot = leads.filter(l => l.status === 'hot');\nlet bookings = 0;\ntry {\n  bookings = $('Tomorrow\\'s Bookings').all().length;\n} catch (e) {}\nconst text = [\n  `📊 Today on WhatsApp`,\n  `💬 Chats: ${leads.length}`,\n  `🔥 Hot leads: ${hot.length}`,\n  `📅 Bookings tomorrow: ${bookings}`,\n  hot.length ? `\\nCall these first:\\n` + hot.slice(0, 5).map(h => `• ${h.name} (+${h.phone}): ${h.interest}`).join('\\n') : ''\n].filter(Boolean).join('\\n');\nreturn [{ json: { text } }];"
      },
      "id": "06373190-00d9-407a-b95b-47616ecf2e97",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "{{WHATSAPP_PHONE_NUMBER_ID}}",
        "recipientPhoneNumber": "{{OWNER_WHATSAPP_NUMBER}}",
        "textBody": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "f05f5866-980d-4774-9282-e545fd7efd89",
      "name": "Send Report to Owner's WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "FLNobig6mXUL6LB5",
          "name": "WhatsApp account"
        }
      }
    }
  ],
  "connections": {
    "Every Night 10PM": {
      "main": [
        [
          {
            "node": "Today's Leads",
            "type": "main",
            "index": 0
          },
          {
            "node": "Tomorrow's Bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test Trigger": {
      "main": [
        [
          {
            "node": "Today's Leads",
            "type": "main",
            "index": 0
          },
          {
            "node": "Tomorrow's Bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Today's Leads": {
      "main": [
        [
          {
            "node": "Merge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tomorrow's Bookings": {
      "main": [
        [
          {
            "node": "Merge",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge": {
      "main": [
        [
          {
            "node": "Build Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Report": {
      "main": [
        [
          {
            "node": "Send Report to Owner's WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  }
}

