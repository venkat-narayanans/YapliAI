# ===================================================
# Yapli AI - Production Cloud Environment Configuration
# ===================================================

# Custom Domain (Point DNS A record to your VPS IP)
DOMAIN=app.yapli.ai
TIMEZONE=Asia/Kolkata

# PostgreSQL Credentials
POSTGRES_USER=yapli_admin
POSTGRES_PASSWORD=GenerateStrongRandomPasswordHere!
POSTGRES_DB=yapli_n8n

# n8n Production Security
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=Generate32ByteEncryptionKeyHere

# n8n API Key (Generated in n8n UI -> Settings -> API)
N8N_API_KEY=your_production_n8n_api_key

# Global AI & Meta Keys (Fallback)
GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

