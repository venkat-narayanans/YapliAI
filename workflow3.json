{
  "name": "3. Appointment Reminders Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "e2f10001-1111-4000-8000-000000000001",
      "name": "Daily 8 AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Reminders",
          "mode": "name"
        },
        "options": {}
      },
      "id": "e2f10002-2222-4000-8000-000000000002",
      "name": "Get Reminders",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "r1",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "completed"
            },
            {
              "id": "r2",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "cancelled"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e2f10003-3333-4000-8000-000000000003",
      "name": "Filter Pending Reminders",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ String($json.phone).replace(/\\D/g, '') }}",
        "textBody": "=Hello {{ $json.name }}! ✨ Friendly reminder of your upcoming salon appointment today for {{ $json.appointment }}. If you need directions or wish to reschedule, simply reply to this chat.",
        "additionalFields": {}
      },
      "id": "e2f10004-4444-4000-8000-000000000004",
      "name": "Send WhatsApp Reminder",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        680,
        200
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "FLNobig6mXUL6LB5",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Reminders",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ String($('Filter Pending Reminders').item.json.phone).replace(/\\D/g, '') }}",
            "status": "reminder_sent"
          },
          "matchingColumns": [
            "phone"
          ]
        },
        "options": {}
      },
      "id": "e2f10005-5555-4000-8000-000000000005",
      "name": "Update Reminder Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [
        920,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "manual-trigger-jniyrxx3fa84z8p3",
      "name": "Manual Test Trigger",
      "webhookId": "wf3-test-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        200
      ],
      "parameters": {
        "path": "wf3-test-trigger",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      }
    }
  ],
  "connections": {
    "Daily 8 AM Trigger": {
      "main": [
        [
          {
            "node": "Get Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Reminders": {
      "main": [
        [
          {
            "node": "Filter Pending Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Pending Reminders": {
      "main": [
        [
          {
            "node": "Send WhatsApp Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Reminder": {
      "main": [
        [
          {
            "node": "Update Reminder Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test Trigger": {
      "main": [
        [
          {
            "node": "Get Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  }
}