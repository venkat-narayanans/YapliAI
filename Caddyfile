{
    email admin@yapliai.com
}

{$DOMAIN:n8n.youragency.com} {
    reverse_proxy n8n:5678 {
        flush_interval -1
    }

    # Enable compression
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }
}
