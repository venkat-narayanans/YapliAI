{
  "name": "4. Invoice & Payment Chaser",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 2
            }
          ]
        }
      },
      "id": "e3f10001-1111-4000-8000-000000000001",
      "name": "Every 2 Days",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "options": {}
      },
      "id": "e3f10002-2222-4000-8000-000000000002",
      "name": "Get Invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "i1",
              "leftValue": "={{ $json.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "pending"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e3f10003-3333-4000-8000-000000000003",
      "name": "Filter Unpaid Invoices",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ String($json.phone).replace(/\\D/g, '') }}",
        "textBody": "=Hi {{ $json.customer_name }}, here is a polite reminder regarding your pending salon invoice #{{ $json.invoice_no }} for {{ $json.amount }}.\n\nYou can complete payment securely here: {{ $json.payment_link }}\nThank you for choosing us!",
        "additionalFields": {}
      },
      "id": "e3f10004-4444-4000-8000-000000000004",
      "name": "Send Payment WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        680,
        200
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "FLNobig6mXUL6LB5",
          "name": "WhatsApp account"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "invoice_no": "={{ $('Filter Unpaid Invoices').item.json.invoice_no }}",
            "stage_sent": "reminder_dispatched",
            "last_reminder_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [
            "invoice_no"
          ]
        },
        "options": {}
      },
      "id": "e3f10005-5555-4000-8000-000000000005",
      "name": "Update Invoice Record",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [
        920,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "LcfWe9ulrfuVwEXk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "manual-trigger-7lo7lmnl5ta1khce",
      "name": "Manual Test Trigger",
      "webhookId": "wf4-test-trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        200
      ],
      "parameters": {
        "path": "wf4-test-trigger",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      }
    }
  ],
  "connections": {
    "Every 2 Days": {
      "main": [
        [
          {
            "node": "Get Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Invoices": {
      "main": [
        [
          {
            "node": "Filter Unpaid Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Unpaid Invoices": {
      "main": [
        [
          {
            "node": "Send Payment WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Payment WhatsApp": {
      "main": [
        [
          {
            "node": "Update Invoice Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test Trigger": {
      "main": [
        [
          {
            "node": "Get Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  }
}